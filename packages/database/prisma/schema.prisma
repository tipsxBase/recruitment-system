generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String                 @id @default(uuid()) /// 主键
  username       String                 @unique /// 用户名，唯一
  password       String /// 密码（加密存储，推荐使用 bcrypt）
  email          String?                @unique /// 邮箱，可选
  emailVerified  Boolean                @default(false) /// 邮箱是否已激活
  employeeNo     String?                @unique /// 工号，唯一
  phone          String?                @unique /// 手机号，唯一
  status         UserStatus             @default(ACTIVE) /// 状态：启用/禁用
  departmentId   String? /// 所属部门
  department     Department?            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  roles          UserRole[] /// 多角色，可分配
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime? /// 软删除时间
  isDeleted      Boolean                @default(false) /// 是否已删除
  // 关联
  postsCreated   Post[]                 @relation("PostCreatedBy") /// 创建的岗位
  candidates     Candidate[]            @relation("CandidateCreatedBy") /// 录入的候选人
  departmentLed  Department[]           @relation("Leader") /// 管理的部门
  interviewTasks InterviewTask[] /// 作为面试官的面试任务
  assessments    DepartmentAssessment[] /// 部门评定记录
  notifications  Notification[] /// 接收的通知
  logs           OperationLog[] /// 操作日志
  attachments    Attachment[] /// 上传的附件
  statusChanges  CandidateStatusHistory[] /// 执行的状态变更

  @@index([status])
  @@index([departmentId])
  @@index([createdAt])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([departmentId, status])
  @@index([isDeleted, status])
}

/// 用户状态
enum UserStatus {
  ACTIVE
  DISABLED
}

/// 部门表（支持多级结构和负责人）
model Department {
  id         String           @id @default(uuid())
  name       String /// 部门名称
  parentId   String? /// 上级部门
  parent     Department?      @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children   Department[]     @relation("DepartmentHierarchy") /// 下级部门
  leaderId   String? /// 负责人
  leader     User?            @relation("Leader", fields: [leaderId], references: [id], onDelete: SetNull)
  orgId      String? /// 所属公司/组织
  org        Organization?    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  status     DepartmentStatus @default(ACTIVE)
  level      Int              @default(1) /// 部门层级深度，根部门为1
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime? /// 软删除时间
  isDeleted  Boolean          @default(false) /// 是否已删除
  // 关联
  users      User[]
  posts      Post[]
  candidates Candidate[]

  @@index([status])
  @@index([orgId])
  @@index([parentId])
  @@index([leaderId])
  @@index([level])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([orgId, status])
  @@index([isDeleted, status])
}

/// 部门状态
enum DepartmentStatus {
  ACTIVE
  DISABLED
}

/// 公司/组织表（支持多公司/多组织扩展）
model Organization {
  id          String       @id @default(uuid())
  name        String /// 企业/组织名称
  code        String?      @unique /// 编号
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]

  @@index([createdAt])
}

/// 角色表（内置/自定义角色，含权限分配）
model Role {
  id          String       @id @default(uuid())
  name        String /// 角色名称
  code        String?      @unique /// 角色编码
  description String? /// 描述
  isSystem    Boolean      @default(false) /// 是否内置（系统级不可删改）
  permissions Permission[] /// 菜单/按钮权限
  users       UserRole[] /// 关联用户
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([isSystem])
  @@index([createdAt])
}

/// 用户-角色多对多中间表
model UserRole {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId     String
  assignedAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([assignedAt])
}

/// 权限表（菜单、按钮等粒度，支持分配到角色）
model Permission {
  id        String         @id @default(uuid())
  name      String /// 权限名称
  code      String?        @unique /// 权限编码
  type      PermissionType /// 类型：菜单/按钮
  parentId  String?
  parent    Permission?    @relation("PermissionHierarchy", fields: [parentId], references: [id])
  children  Permission[]   @relation("PermissionHierarchy")
  roles     Role[] /// 关联角色
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([type])
  @@index([parentId])
  @@index([type, parentId])
}

/// 权限类型
enum PermissionType {
  MENU
  BUTTON
}

/// 岗位表（招聘岗位，含状态流转）
model Post {
  id            String         @id @default(uuid())
  name          String /// 岗位名称
  departmentId  String /// 所属部门
  department    Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jd            String? /// JD描述
  hiringCount   Int? /// 招聘人数
  priority      Int? /// 优先级
  location      String? /// 工作地点
  status        PostStatus     @default(OPEN) /// 岗位状态
  createdById   String
  createdBy     User           @relation("PostCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  closedAt      DateTime?
  restoredAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime? /// 软删除时间
  isDeleted     Boolean        @default(false) /// 是否已删除
  candidates    Candidate[] /// 关联候选人
  interviews    Interview[] /// 面试流程
  notifications Notification[] @relation("PostNotifications") /// 相关通知

  @@index([status])
  @@index([departmentId])
  @@index([createdById])
  @@index([createdAt])
  @@index([priority])
  @@index([location])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([status, departmentId])
  @@index([status, createdAt])
  @@index([isDeleted, status])
  @@index([departmentId, isDeleted])
}

/// 岗位状态
enum PostStatus {
  OPEN
  PAUSED
  CLOSED
}

/// 候选人表（含简历、评定、状态流转等）
model Candidate {
  id               String                 @id @default(uuid())
  name             String /// 姓名
  email            String? /// 邮箱
  phone            String? /// 手机号
  resumeUrl        String? /// 简历附件链接
  remarks          String? /// 备注
  status           CandidateStatus        @default(NEW) /// 当前状态
  source           String? /// 候选人来源（内推、网申、猎头等）
  expectedSalary   String? /// 期望薪资
  currentCompany   String? /// 当前公司
  workExperience   Int? /// 工作年限
  departmentId     String /// 目标部门
  department       Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  postId           String /// 目标岗位
  post             Post                   @relation(fields: [postId], references: [id], onDelete: Restrict)
  createdById      String
  createdBy        User                   @relation("CandidateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assessment       DepartmentAssessment[] /// 部门评定记录
  interviews       Interview[] /// 面试流程
  notifications    Notification[]         @relation("CandidateNotifications") /// 相关通知
  statusHistory    CandidateStatusHistory[] /// 状态变更历史
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime? /// 软删除时间
  isDeleted        Boolean                @default(false) /// 是否已删除

  @@index([status])
  @@index([departmentId])
  @@index([postId])
  @@index([createdById])
  @@index([createdAt])
  @@index([email])
  @@index([phone])
  @@index([source])
  @@index([workExperience])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([status, departmentId])
  @@index([status, postId])
  @@index([status, createdAt])
  @@index([isDeleted, status])
  @@index([departmentId, isDeleted])
  @@index([postId, status])
}

/// 候选人状态变更历史表
model CandidateStatusHistory {
  id           String          @id @default(uuid())
  candidateId  String /// 候选人ID
  candidate    Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fromStatus   CandidateStatus? /// 原状态
  toStatus     CandidateStatus /// 目标状态
  reason       String? /// 变更原因
  operatorId   String /// 操作人
  operator     User            @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  createdAt    DateTime        @default(now())

  @@index([candidateId])
  @@index([operatorId])
  @@index([toStatus])
  @@index([createdAt])
  @@index([candidateId, createdAt])
  @@index([candidateId, toStatus])
}

/// 候选人状态
enum CandidateStatus {
  NEW
  DEPARTMENT_ASSESSING // 部门评定中
  DEPARTMENT_PASSED // 评定通过
  DEPARTMENT_FAILED // 评定不通过
  INTERVIEWING
  OFFERED // 录用
  REJECTED // 淘汰
}

/// 部门评定表（会签/审核，支持多评定人）
model DepartmentAssessment {
  id          String           @id @default(uuid())
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String
  assessorId  String /// 评定人
  assessor    User             @relation(fields: [assessorId], references: [id])
  result      AssessmentResult /// 评定结果
  remarks     String?
  assessedAt  DateTime         @default(now())

  @@index([candidateId])
  @@index([assessorId])
  @@index([result])
  @@index([assessedAt])
  @@index([candidateId, result])
}

/// 评定结果
enum AssessmentResult {
  PASSED
  FAILED
  PENDING
}

/// 面试主表（一次大面试流程，如一面/二面/HR面等）
/// 一条记录代表一次轮次的面试
model Interview {
  id             String          @id @default(uuid())
  candidateId    String
  candidate      Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  postId         String
  post           Post            @relation(fields: [postId], references: [id], onDelete: Restrict)
  round          Int /// 第几轮面试
  status         InterviewStatus @default(SCHEDULED)
  scheduledAt    DateTime /// 该轮面试计划时间
  actualStartAt  DateTime? /// 实际开始时间
  actualEndAt    DateTime? /// 实际结束时间
  location       String? /// 面试地点
  meetingLink    String? /// 在线面试链接
  notes          String? /// 面试备注
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime? /// 软删除时间
  isDeleted      Boolean         @default(false) /// 是否已删除
  /// 面试子表
  interviewTasks InterviewTask[]

  @@index([candidateId])
  @@index([postId])
  @@index([status])
  @@index([scheduledAt])
  @@index([round])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([candidateId, status])
  @@index([candidateId, round])
  @@index([isDeleted, status])
  @@index([scheduledAt, status])
}

/// 面试子单表（每次只关联一个面试官，每流转一次创建一条，便于并行/串行）
model InterviewTask {
  id            String              @id @default(uuid())
  interviewId   String
  interview     Interview           @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewerId String /// 面试官（单人）
  interviewer   User                @relation(fields: [interviewerId], references: [id], onDelete: Restrict)
  sequence      Int /// 并行/串行顺序标记（如1,2,3等）
  status        InterviewTaskStatus @default(SCHEDULED)
  scheduledAt   DateTime? /// 该面试官实际约面时间
  actualStartAt DateTime? /// 实际开始时间
  actualEndAt   DateTime? /// 实际结束时间
  feedback      String? /// 面试反馈
  feedbackScore Int? /// 评价分数/维度
  feedbackAt    DateTime?
  decision      String? /// 面试决定（通过/不通过/待定）
  notified      Boolean             @default(false) /// 是否已发通知
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime? /// 软删除时间
  isDeleted     Boolean             @default(false) /// 是否已删除

  @@index([interviewId])
  @@index([interviewerId])
  @@index([status])
  @@index([scheduledAt])
  @@index([sequence])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([interviewId, sequence])
  @@index([interviewerId, status])
  @@index([isDeleted, status])
  @@index([feedbackAt])
}

/// 面试主表状态
enum InterviewStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// 面试子单状态
enum InterviewTaskStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// 通知消息表（系统消息、邮箱、短信等）
model Notification {
  id                 String           @id @default(uuid())
  type               NotificationType
  title              String
  content            String
  receiverId         String /// 接收人
  receiver           User             @relation(fields: [receiverId], references: [id])
  isRead             Boolean          @default(false)
  sentAt             DateTime         @default(now())
  relatedPostId      String?
  relatedPost        Post?            @relation("PostNotifications", fields: [relatedPostId], references: [id])
  relatedCandidateId String?
  relatedCandidate   Candidate?       @relation("CandidateNotifications", fields: [relatedCandidateId], references: [id])

  @@index([receiverId])
  @@index([isRead])
  @@index([type])
  @@index([sentAt])
  @@index([receiverId, isRead])
  @@index([relatedPostId])
  @@index([relatedCandidateId])
}

/// 消息类型
enum NotificationType {
  SYSTEM
  EMAIL
  SMS
}

/// 操作日志表（审计与追踪）
model OperationLog {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  action     String /// 操作内容描述（如：创建、更新、删除、登录、导出等）
  module     String /// 业务模块（如：USER、CANDIDATE、POST、INTERVIEW、DEPARTMENT等）
  objectId   String? /// 关联对象ID
  objectType String? /// 关联对象类型（如：User、Candidate、Post等）
  objectName String? /// 对象名称/标识（便于查看，如用户名、候选人姓名等）
  details    Json? /// 操作详情（JSON格式，存储变更前后的数据）
  ipAddress  String? /// 操作IP地址
  userAgent  String? /// 用户代理信息
  result     LogResult @default(SUCCESS) /// 操作结果
  errorMsg   String? /// 错误信息（如果操作失败）
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([module])
  @@index([objectType])
  @@index([objectId])
  @@index([action])
  @@index([result])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([module, createdAt])
  @@index([module, action])
  @@index([objectType, objectId])
}

/// 操作结果
enum LogResult {
  SUCCESS /// 成功
  FAILED /// 失败
  PARTIAL /// 部分成功
}

/// 附件表（简历等上传文件，简化设计）
model Attachment {
  id            String             @id @default(uuid())
  url           String             /// 文件访问地址
  fileName      String             /// 存储文件名
  originalName  String             /// 原始文件名
  fileType      String             /// 文件类型（MIME type）
  fileSize      Int?               /// 文件大小（字节）
  category      AttachmentCategory @default(OTHER) /// 附件分类
  description   String?            /// 文件描述
  
  // 简化的多态关联 - 只保留必要的
  entityType    String             /// 关联实体类型 (POST, CANDIDATE, INTERVIEW, USER)
  entityId      String             /// 关联实体ID
  
  uploaderId    String             /// 上传人
  uploader      User               @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?          /// 软删除时间
  isDeleted     Boolean            @default(false) /// 是否已删除

  @@index([uploaderId])
  @@index([fileType])
  @@index([category])
  @@index([entityType, entityId]) /// 联合索引提升查询效率
  @@index([isDeleted])
  @@index([createdAt])
  @@index([uploaderId, isDeleted])
  @@index([entityType, isDeleted])
}

/// 附件分类
enum AttachmentCategory {
  RESUME /// 简历
  PORTFOLIO /// 作品集
  CERTIFICATE /// 证书
  JOB_DESCRIPTION /// 岗位描述
  INTERVIEW_FEEDBACK /// 面试反馈
  CONTRACT /// 合同
  OTHER /// 其他
}

/// 邮箱验证码表（替代内存存储）
model EmailVerificationCode {
  id          String   @id @default(uuid())
  email       String /// 邮箱地址
  code        String /// 验证码
  attempts    Int      @default(0) /// 尝试次数
  expiresAt   DateTime /// 过期时间
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([expiresAt])
  @@index([email, expiresAt])
}
